### UDIP — Example API Requests
### Compatible with VS Code REST Client extension and JetBrains HTTP Client
### Replace {{FILE_ID}} with the actual file_id returned from /upload

@base_url = http://localhost:8000


# ─────────────────────────────────────────────────────────────────────────────
# 0. Health Check
# ─────────────────────────────────────────────────────────────────────────────

GET {{base_url}}/health
Accept: application/json

###

# ─────────────────────────────────────────────────────────────────────────────
# 1. Upload a TXT file (invoice)
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/upload
Content-Type: multipart/form-data; boundary=---boundary

-----boundary
Content-Disposition: form-data; name="file"; filename="sample_invoice.txt"
Content-Type: text/plain

< ./sample_files/sample_invoice.txt
-----boundary--

###

# ─────────────────────────────────────────────────────────────────────────────
# 2. Upload a CSV file
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/upload
Content-Type: multipart/form-data; boundary=---boundary

-----boundary
Content-Disposition: form-data; name="file"; filename="sample_employees.csv"
Content-Type: text/csv

< ./sample_files/sample_employees.csv
-----boundary--

###

# ─────────────────────────────────────────────────────────────────────────────
# 3. Extract — Replace FILE_ID with value from /upload response
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/extract
Content-Type: application/json

{
  "file_id": "PASTE_FILE_ID_HERE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 4. Export as JSON
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/export/json
Content-Type: application/json

{
  "file_id": "PASTE_FILE_ID_HERE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 5. Export as CSV (downloads file)
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/export/csv
Content-Type: application/json

{
  "file_id": "PASTE_FILE_ID_HERE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 6. Export as XML (downloads file)
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/export/xml
Content-Type: application/json

{
  "file_id": "PASTE_FILE_ID_HERE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 7. Export as XLSX / Excel (downloads file)
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/export/xlsx
Content-Type: application/json

{
  "file_id": "PASTE_FILE_ID_HERE"
}

###

# ─────────────────────────────────────────────────────────────────────────────
# 8. Error Cases — Unsupported file type
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/upload
Content-Type: multipart/form-data; boundary=---boundary

-----boundary
Content-Disposition: form-data; name="file"; filename="bad_file.exe"
Content-Type: application/octet-stream

MZXXXXXXX
-----boundary--

###

# ─────────────────────────────────────────────────────────────────────────────
# 9. Error Cases — File not found
# ─────────────────────────────────────────────────────────────────────────────

POST {{base_url}}/extract
Content-Type: application/json

{
  "file_id": "00000000-0000-0000-0000-000000000000"
}

###
